# 开始生成
@router.post("/api/generation/start")
async def start_generation(req: StartGenerationRequest, background_tasks: BackgroundTasks):
    # 启动队列处理器（如果尚未启动）
    if not _queue_processor_started:
        background_tasks.add_task(start_optimized_queue_processor)
    
    # 创建任务ID
    task_id = str(uuid4())
    
    # 从项目存储中获取配置
    if req.projectId not in _project_storage:
        return {
            "success": False,
            "error": "项目不存在"
        }
    
    clip_req = _project_storage[req.projectId]
    
    # 初始化任务状态
    _task_storage[task_id] = {
        "status": "queued",
        "progress": 0,
        "createdAt": datetime.now().isoformat(),
        "updatedAt": datetime.now().isoformat(),
        "projectId": req.projectId
    }
    
    # 添加任务到队列
    await _task_queue.put({
        "task_id": task_id,
        "clip_req": clip_req
    })
    
    # 获取队列状态
    queue_status = get_queue_status()
    
    # 计算等待时间
    if queue_status["availableWorkers"] > 0:
        estimated_wait = "即将开始处理"
    else:
        queue_position = queue_status["queueSize"]
        estimated_wait = f"预计等待 {queue_position * 3} 分钟"
    
    return {
        "success": True,
        "data": {
            "projectId": req.projectId,
            "id": task_id,
            "status": "queued",
            "progress": 0,
            "queuePosition": queue_status["queueSize"],
            "processingCount": queue_status["processingCount"],
            "availableWorkers": queue_status["availableWorkers"],
            "estimatedWaitTime": estimated_wait,
            "createdAt": _task_storage[task_id]["createdAt"]
        }
    }

