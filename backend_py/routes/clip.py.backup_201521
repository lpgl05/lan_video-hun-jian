        return {"success": False, "message": "Invalid task ID"}
async def get_generation_status(task_id: str):
    # 从存储中获取任务状态
    if task_id not in _task_storage:
        return {
            "success": False,
            "error": "任务不存在"
        }
    
    task_data = _task_storage[task_id].copy()
    queue_status = get_queue_status()
    
    # 添加队列相关信息
    if task_data["status"] == "queued":
        # 计算在队列中的位置
        queue_position = _task_queue.qsize()
        task_data["queuePosition"] = queue_position
        task_data["currentQueueSize"] = queue_position
        task_data["processingCount"] = queue_status["processingCount"]
        task_data["availableWorkers"] = queue_status["availableWorkers"]
        
        if queue_status["availableWorkers"] > 0:
            task_data["estimatedWaitTime"] = "即将开始处理"
        else:
            task_data["estimatedWaitTime"] = f"预计等待 {queue_position * 3} 分钟"
    
    elif task_data["status"] == "processing":
        task_data["processingCount"] = queue_status["processingCount"]
        task_data["worker"] = task_data.get("worker", "未知")
        task_data["estimatedWaitTime"] = "正在处理中"
    
    return {
        "success": True,
        "data": task_data,
        "queueInfo": queue_status
    }

