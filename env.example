# 数据库配置
MONGODB_URI=mongodb://localhost:27017/video-mixer

# 服务器配置
PORT=3001
NODE_ENV=development

# 阿里云OSS配置
OSS_ACCESS_KEY_ID=你的AccessKeyId
OSS_ACCESS_KEY_SECRET=你的AccessKeySecret
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET_NAME=tian-jiu-video

# OSS上传性能优化配置
OSS_CONNECTION_POOL_SIZE=50
OSS_CONNECTION_TIMEOUT=30
OSS_READ_TIMEOUT=300
OSS_MAX_CONCURRENT_UPLOADS=10
OSS_MULTIPART_THRESHOLD=10
OSS_PART_SIZE_SMALL=10
OSS_PART_SIZE_MEDIUM=20
OSS_PART_SIZE_LARGE=50
OSS_PART_SIZE_XLARGE=100
OSS_SMALL_FILE_THRESHOLD=50
OSS_MEDIUM_FILE_THRESHOLD=200
OSS_LARGE_FILE_THRESHOLD=500
OSS_MAX_RETRIES=3
OSS_RETRY_DELAY=1.0
OSS_ENABLE_CRC=false
OSS_ENABLE_MD5=false

# OpenAI API配置
FASTGPT_API_URL=https://api.fastgpt.in/api/v1/chat/completions
# FastGPT工作流插件ID（文案改写插件）
FASTGPT_PLUGIN_ID=6892b5a09c05020632793129
FASTGPT_API_KEY=你的API密钥

# 配置字体
VIDEO_FONT=msyh.ttc