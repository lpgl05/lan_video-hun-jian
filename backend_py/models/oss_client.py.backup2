import os
import hashlib
import oss2
from typing import Optional, Callable
from dotenv import load_dotenv

load_dotenv()

class OSSClient:
    def __init__(self):
        self.access_key_id = os.getenv('OSS_ACCESS_KEY_ID')
        self.access_key_secret = os.getenv('OSS_ACCESS_KEY_SECRET')
        self.endpoint = os.getenv('OSS_ENDPOINT')
        self.bucket_name = os.getenv('OSS_BUCKET_NAME')
        
        if not all([self.access_key_id, self.access_key_secret, self.endpoint, self.bucket_name]):
            raise ValueError("OSS配置不完整，请检查环境变量")
        
        self.auth = oss2.Auth(self.access_key_id, self.access_key_secret)
        self.bucket = oss2.Bucket(self.auth, self.endpoint, self.bucket_name)
        
        # 测试连接
        self._test_connection()
    
    def _test_connection(self):
        """测试OSS连接"""
        try:
            self.bucket.list_objects(max_keys=1)
            print("✅ OSS连接测试成功")
        except Exception as e:
            print(f"❌ OSS连接测试失败: {e}")
            raise
    
    def _test_permissions(self):
        """测试OSS权限"""
        try:
            # 测试读取权限
            self.bucket.list_objects(max_keys=1)
            
            # 测试写入权限
            test_key = 'test_permissions.txt'
            test_content = 'OSS权限测试文件'
            self.bucket.put_object(test_key, test_content)
            
            # 测试删除权限
            self.bucket.delete_object(test_key)
            
            # 测试文件存在性检查权限
            try:
                self.bucket.head_object('non_existent_file.txt')
            except oss2.exceptions.NoSuchKey:
                pass  # 这是期望的异常
            
            print("✅ OSS权限测试成功")
            return True
        except Exception as e:
            print(f"❌ OSS权限测试失败: {e}")
            return False
    
    def upload_file_with_deduplication(
        self, 
        file_buffer: bytes, 
        expected_file_name: str,
        progress_callback: Optional[Callable[[float, int, int], None]] = None,
        mimetype: Optional[str] = None
    ) -> str:
        """
        上传文件并支持去重功能
        
        Args:
            file_buffer: 文件内容
            expected_file_name: 期望的文件名
            progress_callback: 进度回调函数
            mimetype: MIME类型
            
        Returns:
            上传后的文件URL
        """
        try:
            # 测试权限
            if not self._test_permissions():
                print(f"⚠️ OSS权限不足，直接上传: {expected_file_name}")
                return self._upload_file_direct(file_buffer, expected_file_name, progress_callback, mimetype)
            
            # 计算文件哈希
            file_hash = hashlib.md5(file_buffer).hexdigest()
            hash_file_name = f"hash_{file_hash}_{os.path.basename(expected_file_name)}"
            
            # 检查文件是否已存在
            try:
                existing_url = self._check_file_exists(hash_file_name)
                if existing_url:
                    print(f"✅ 文件已存在，跳过上传: {hash_file_name}")
                    if progress_callback:
                        progress_callback(100.0, len(file_buffer), 0)
                    return existing_url
            except Exception as e:
                print(f"⚠️ 检查文件存在时出错: {e}，继续上传")
            
            # 上传文件
            return self._upload_file_direct(file_buffer, hash_file_name, progress_callback, mimetype)
            
        except Exception as e:
            print(f"❌ 上传文件失败: {e}")
            # 降级到直接上传
            return self._upload_file_direct(file_buffer, expected_file_name, progress_callback, mimetype)
    
    def _check_file_exists(self, file_name: str) -> Optional[str]:
        """检查文件是否存在"""
        try:
            self.bucket.head_object(file_name)
            return f"https://{self.bucket_name}.{self.endpoint.replace('https://', '')}/{file_name}"
        except oss2.exceptions.NoSuchKey:
            return None
        except Exception as e:
            print(f"检查文件存在时出错: {e}")
            return None
    
    def _upload_file_direct(
        self, 
        file_buffer: bytes, 
        file_name: str,
        progress_callback: Optional[Callable[[float, int, int], None]] = None,
        mimetype: Optional[str] = None
    ) -> str:
        """直接上传文件"""
        try:
            # 设置请求头
            headers = {}
            if mimetype:
                headers['Content-Type'] = mimetype
            
            # 上传文件
            result = self.bucket.put_object(file_name, file_buffer, headers=headers)
            
            # 生成URL
            file_url = f"https://{self.bucket_name}.{self.endpoint.replace('https://', '')}/{file_name}"
            
            print(f"✅ 文件上传成功: {file_name}")
            return file_url
            
        except Exception as e:
            print(f"❌ 文件上传失败: {e}")
            raise
    
    def upload_file(
        self, 
        file_buffer: bytes, 
        expected_file_name: str,
        progress_callback: Optional[Callable[[float, int, int], None]] = None,
        mimetype: Optional[str] = None
    ) -> str:
        """上传文件（兼容性方法）"""
        return self.upload_file_with_deduplication(file_buffer, expected_file_name, progress_callback, mimetype)
